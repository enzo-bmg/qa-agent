# Exemplo de configuração local. Copie para .env.local e preencha.
# O .env.local NÃO é versionado (contém config de conta/perfil).

# Tools: true = ChromaDB local + mocks; false = MCP Gateway remoto
USE_LOCAL_TOOLS=true

# Knowledge Base
USE_BEDROCK_KB=true
BEDROCK_KB_ID=

# AWS
AWS_PROFILE=
AWS_REGION=us-east-1

# Modelo (opcional — sobrescreve o default se o BMG habilitar outra versão)
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Guardrail plugado no BedrockModel.
# Sem GUARDRAIL_ID o modelo sobe SEM guardrail (só dev local, nunca com dado real).
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=DRAFT
# GUARDRAIL_REDACT_INPUT=true
# GUARDRAIL_REDACT_OUTPUT=false
